# PropEdge Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Application
# ============================================
NODE_ENV=development
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:8787
VITE_WS_URL=ws://localhost:8787

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propedge
DATABASE_POOL_SIZE=20

# ============================================
# Redis (Caching & Queues)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# ============================================
# Authentication
# ============================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Data Providers
# ============================================
# The Odds API - Get key at https://the-odds-api.com
ODDS_API_KEY=your-odds-api-key

# OddsJam (optional, premium)
ODDSJAM_API_KEY=
ODDSJAM_WS_URL=

# Pinnacle (affiliate)
PINNACLE_API_KEY=
PINNACLE_API_SECRET=

# SportRadar (enterprise)
SPORTRADAR_API_KEY=

# ============================================
# Payment Providers
# ============================================
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Paddle (alternative)
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ============================================
# Email (Resend, SendGrid, etc.)
# ============================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@propedge.app

# ============================================
# Notifications
# ============================================
# Discord
DISCORD_WEBHOOK_URL=

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Push (Web Push Protocol)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@propedge.app

# ============================================
# Monitoring & Analytics
# ============================================
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# Feature Flags
# ============================================
ENABLE_LIVE_ODDS=true
ENABLE_ARBITRAGE=true
ENABLE_COMMUNITY=true
ENABLE_API=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000